# -- AI Provider --
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model name -- Google retires model names periodically.  If you get a
# 404 "model no longer available" error, update this to the model name
# shown in the error message.
# Recommended: gemini-3.6-flash (current stable)
# Other options: gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.6-flash

# -- Weather Data --
# Get a free key at https://openweathermap.org/api
# Sign up → API Keys → copy the key (may take ~10 min to activate)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# -- Server Settings --
BACKEND_HOST=http://localhost:8000
BACKEND_PORT=8000

# -- Twilio (WhatsApp Bot) --
# Sign up free at https://www.twilio.com/try-twilio
# After signup, find credentials at https://console.twilio.com
# 1. TWILIO_ACCOUNT_SID: your Account SID (starts with "AC...")
# 2. TWILIO_AUTH_TOKEN: your Auth Token (click "View" to reveal)
# 3. TWILIO_WHATSAPP_NUMBER: the WhatsApp Sandbox number shown on
#    https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
